class Stackloom < Formula
  include Language::Python::Virtualenv

  desc "Local control centre for a development workspace"
  homepage "https://www.nafees.info"
  url "@URL@"
  sha256 "@SHA256@"
  license "@LICENSE@"

  depends_on "rust" => :build # pydantic-core
  depends_on "numpy"          # codecortex-engine; Homebrew's build, not a resource
  depends_on "python@3.13"

  # Resources are generated by `brew update-python-resources --exclude-packages numpy`.

  def install
    virtualenv_install_with_resources
  end

  service do
    run [opt_bin/"stackloom", "--foreground", "--no-browser"]
    keep_alive false
    log_path var/"log/stackloom.log"
    error_log_path var/"log/stackloom.log"
  end

  test do
    ENV["STACKLOOM_HOME"] = testpath/"home"
    assert_match version.to_s, shell_output("#{bin}/stackloom --version")
    system bin/"stackloom", "init", "--workspace", testpath
    assert_match "Projects", shell_output("#{bin}/stackloom status")
  end
end
